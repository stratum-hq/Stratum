{
  "name": "stratum",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "generate:sdk": "bash scripts/generate-sdks.sh",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
