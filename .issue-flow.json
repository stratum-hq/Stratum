{
  "pluginVersion": "0.16.0",
  "concurrency": 3,
  "batchSize": 4,
  "runLength": "until-backlog-empty",
  "prGranularity": "batch",
  "prAuthority": "autonomous",
  "planReview": false,
  "reviewWipLimit": 2,
  "branchModel": "trunk",
  "practices": {
    "tdd": true,
    "ddd": false,
    "e2e": "none",
    "coverage": null,
    "commitStyle": "conventional",
    "docs": "public-api",
    "changesets": true,
    "realDbTestsForSql": true
  },
  "deploy": {
    "mode": "none",
    "note": "Packages release by annotated tag per CLAUDE.md section 6. landing/ and website/ deploy to Cloudflare Pages on push to main; verify with a page fetch when a batch touches them."
  },
  "docsMcp": "none"
}
