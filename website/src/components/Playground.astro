---
// Playground.astro: the real @stratum-hq/lib on PGlite (PostgreSQL in WebAssembly).
// The page loads only this small script. PGlite, the library and the editor
// load after the visitor presses Start.
---

<div class="playground not-content" id="playground-root">
  <div class="pg-start" id="pg-start">
    <p>
      The Playground runs the real <code>@stratum-hq/lib</code> on PostgreSQL compiled to
      WebAssembly (PGlite), in this browser tab. No data goes to a server.
    </p>
    <p class="pg-start-note">Start downloads about 9 MB, one time.</p>
    <button id="start-btn" class="run-btn" type="button">Start</button>
  </div>

  <div class="pg-app" id="pg-app" hidden>
    <div class="playground-tabs" role="tablist" aria-label="Playground mode">
      <button class="tab mode-tab active" data-mode="tour" role="tab" aria-selected="true" aria-controls="tour" type="button">Guided tour</button>
      <button class="tab mode-tab" data-mode="editor" role="tab" aria-selected="false" aria-controls="editor-mode" type="button">Code editor</button>
    </div>

    <section class="tour" id="tour" role="tabpanel" aria-label="Guided tour">
      <ol class="tour-steps" id="tour-steps"></ol>
      <div class="tour-main">
        <div class="step-detail">
          <h3 id="step-title"></h3>
          <p id="step-text"></p>
          <pre id="step-code" class="step-code"></pre>
          <div class="playground-actions">
            <button id="step-run" class="run-btn" type="button">Run this step</button>
            <button id="tour-reset" class="reset-btn" type="button">Restart tour</button>
          </div>
        </div>
        <div class="tour-panels">
          <div class="panel">
            <h4>Tenant tree</h4>
            <ul class="tree" id="tree"><li class="output-dim">No tenants yet.</li></ul>
          </div>
          <div class="panel">
            <h4>Inspector <span id="inspect-name" class="output-dim"></span></h4>
            <table class="inspector" id="inspector-config" aria-label="Resolved config"></table>
            <table class="inspector" id="inspector-perms" aria-label="Resolved permissions"></table>
          </div>
        </div>
        <pre id="tour-output" class="output-pre" aria-live="polite" aria-label="Tour output"></pre>
      </div>
    </section>

    <section class="editor-mode" id="editor-mode" role="tabpanel" aria-label="Code editor" hidden>
      <div class="playground-tabs" role="tablist" aria-label="Scenario tabs">
        <button class="tab scenario-tab active" data-tab="flat" role="tab" aria-selected="true" aria-controls="editor" type="button">Flat Tenancy</button>
        <button class="tab scenario-tab" data-tab="hierarchy" role="tab" aria-selected="false" aria-controls="editor" type="button">Hierarchy</button>
        <button class="tab scenario-tab" data-tab="config" role="tab" aria-selected="false" aria-controls="editor" type="button">Config Inheritance</button>
        <button class="tab scenario-tab" data-tab="gdpr" role="tab" aria-selected="false" aria-controls="editor" type="button">GDPR Compliance</button>
      </div>
      <div class="playground-panes">
        <div class="playground-editor" id="editor" role="region" aria-label="Code editor"></div>
        <div class="playground-output">
          <div class="output-header">
            <span class="output-label">Output</span>
            <div class="playground-actions">
              <button id="run-btn" class="run-btn" aria-label="Run code" type="button">Run</button>
              <button id="reset-btn" class="reset-btn" aria-label="Reset to scenario default" type="button">Reset</button>
            </div>
          </div>
          <pre id="output" class="output-pre" aria-live="polite" aria-label="Output"></pre>
        </div>
      </div>
    </section>
  </div>

  <div class="playground-status" id="status" aria-live="polite">Press Start to load PostgreSQL and Stratum.</div>
</div>

<style>
  /* The Playground is a terminal session: a double-rule frame, menu-key
     tabs and buttons, and the dark code well. VT323 carries the controls,
     labels and output; the step text reads in the prose face. */
  .playground {
    position: relative;
    width: 100%;
    background: var(--surface-0);
    border: 3px double var(--t-frame);
    display: flex;
    flex-direction: column;
    font-family: var(--prose-font);
  }

  /* The hidden attribute must win over the display rules below. */
  .playground :global([hidden]) {
    display: none !important;
  }

  .pg-start {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .pg-start p {
    margin: 0;
    max-width: 60ch;
    color: var(--text-primary);
  }

  .pg-start .pg-start-note {
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  .playground-tabs {
    display: flex;
    align-items: stretch;
    gap: 4px;
    padding: 6px 8px;
    background: var(--surface-0);
    border-bottom: 1px dashed var(--t-frame);
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }

  .playground-tabs::-webkit-scrollbar {
    display: none;
  }

  /* Tabs are menu keys: the selected one is inverted, vein with ground text. */
  .tab {
    all: unset;
    box-sizing: border-box !important;
    display: inline-flex !important;
    align-items: center !important;
    margin: 0 !important;
    padding: 4px 12px !important;
    min-height: 36px;
    border: none !important;
    color: var(--t-frame);
    font-family: var(--bbs-font);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1.2;
  }

  .tab:hover {
    color: var(--text-primary);
  }

  .tab.active,
  .tab.active:hover {
    background: var(--t-frame);
    color: var(--surface-0);
  }

  .tab:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: -2px;
  }

  /* Guided tour */
  .tour {
    display: grid;
    grid-template-columns: minmax(190px, 230px) 1fr;
    min-height: 560px;
  }

  .tour-steps {
    list-style: none;
    margin: 0;
    padding: 10px 6px;
    border-right: 1px dashed var(--t-frame);
    background: var(--surface-0);
    counter-reset: step;
  }

  .tour-steps :global(li) {
    margin: 0;
  }

  .tour-steps :global(.step-btn) {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 4px 10px;
    font-family: var(--bbs-font);
    font-size: 1.1875rem;
    line-height: 1.2;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .tour-steps :global(.step-btn:hover) {
    color: var(--text-primary);
  }

  .tour-steps :global(.step-btn.current) {
    background: var(--t-frame);
    color: var(--surface-0);
  }

  .tour-steps :global(.step-btn.current)::before {
    content: "> " / "";
  }

  .tour-steps :global(.step-btn.done::after) {
    content: " [OK]";
    color: var(--moss-t);
  }

  .tour-steps :global(.step-btn.current.done::after) {
    color: inherit;
  }

  .tour-steps :global(.step-btn:disabled) {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .tour-steps :global(.step-btn:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: -2px;
  }

  .tour-main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    min-width: 0;
  }

  .step-detail h3 {
    margin: 0 0 6px 0;
    font-family: var(--bbs-font);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--t-str);
  }

  .step-detail p {
    margin: 0 0 10px 0;
    max-width: 68ch;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .step-code {
    margin: 0 0 10px 0;
    padding: 12px 14px;
    max-height: 240px;
    overflow: auto;
    background: var(--well);
    color: var(--well-text);
    border: 1px dashed var(--t-frame);
    border-radius: 0;
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .tour-panels {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 18px;
  }

  /* Panels are framed, with the label sitting on the top rule. */
  .panel {
    position: relative;
    border: 1px dashed var(--t-frame);
    padding: 18px 12px 10px;
    margin-top: 8px;
    background: var(--surface-0);
    min-width: 0;
  }

  .panel h4 {
    position: absolute;
    top: 0;
    left: 10px;
    translate: 0 -55%;
    margin: 0;
    padding: 0 0.4em;
    background: var(--surface-0);
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--t-frame);
  }

  .panel h4 :global(.output-dim) {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .panel > :global(table),
  .panel > .tree {
    display: block;
    overflow-x: auto;
  }

  .tree,
  .tree :global(ul) {
    list-style: none;
    margin: 0;
    padding-left: 2ch;
    font-family: var(--bbs-font);
    font-size: 1.1875rem;
  }

  .tree {
    padding-left: 0;
  }

  .tree :global(li) {
    margin: 1px 0;
  }

  .tree :global(ul li)::before {
    content: "└ " / "";
    color: var(--text-secondary);
  }

  .tree :global(.tree-node) {
    all: unset;
    cursor: pointer;
    padding: 0 4px;
    color: var(--text-primary);
  }

  .tree :global(.tree-node:hover) {
    color: var(--t-frame);
  }

  .tree :global(.tree-node.selected) {
    background: var(--t-frame);
    color: var(--surface-0);
  }

  .tree :global(.tree-node:focus-visible) {
    outline: 2px solid var(--text-primary);
  }

  .inspector {
    width: 100%;
    margin: 0 0 8px 0;
    border-collapse: collapse;
    font-family: var(--bbs-font);
    font-size: 1.25rem;
  }

  .inspector :global(caption) {
    text-align: left;
    padding-bottom: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--t-str);
  }

  .inspector :global(th),
  .inspector :global(td) {
    text-align: left;
    padding: 2px 6px;
    border: 0;
    border-bottom: 1px dashed var(--border);
    font-weight: 400;
  }

  .inspector :global(th) {
    color: var(--t-frame);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Tags: a bracketed word in its color, as everywhere in the docs. The
     locked glyph comes from .badge-locked in custom.css. */
  .inspector :global(.badge) {
    display: inline-flex;
    gap: 0.3rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .inspector :global(.badge-delegated) {
    color: var(--t-num);
  }

  .inspector :global(.badge-delegated)::before {
    content: "[\21C4" / "";
  }

  .inspector :global(.badge-delegated)::after {
    content: "]" / "";
  }

  /* Code editor */
  .playground-panes {
    display: flex;
    flex-direction: row;
    height: 520px;
    overflow: hidden;
  }

  .playground-editor {
    width: 55%;
    border-right: 1px dashed var(--t-frame);
    overflow: hidden;
    background: var(--well);
  }

  .playground-editor :global(.cm-editor) {
    height: 100%;
  }

  .playground-output {
    width: 45%;
    display: flex;
    flex-direction: column;
    background: var(--surface-0);
    overflow: hidden;
  }

  .output-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    border-bottom: 1px dashed var(--t-frame);
    flex-shrink: 0;
  }

  .output-label {
    font-family: var(--bbs-font);
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--t-frame);
  }

  .playground-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  /* Buttons are bracketed menu keys: Run is the one magma key, Reset is
     vein. Hover and focus invert, as on a board. */
  .run-btn,
  .reset-btn {
    all: unset;
    box-sizing: border-box !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 12px !important;
    min-height: 40px !important;
    border-radius: 0 !important;
    font-family: var(--bbs-font) !important;
    font-size: 1.375rem !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
    text-align: center;
  }

  .run-btn::before,
  .reset-btn::before {
    content: "[\00a0";
  }

  .run-btn::after,
  .reset-btn::after {
    content: "\00a0]";
  }

  .run-btn {
    background: var(--t-hot) !important;
    color: var(--on-accent) !important;
  }

  .run-btn:hover,
  .run-btn:focus-visible {
    background: var(--text-primary) !important;
    color: var(--surface-0) !important;
  }

  .run-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .run-btn:focus-visible,
  .reset-btn:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .reset-btn {
    background: transparent !important;
    color: var(--t-frame) !important;
  }

  .reset-btn:hover,
  .reset-btn:focus-visible {
    background: var(--t-frame) !important;
    color: var(--surface-0) !important;
  }

  .output-pre {
    flex: 1;
    margin: 0;
    padding: 12px 14px;
    min-height: 120px;
    overflow-y: auto;
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--t-str);
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--surface-0);
    border: 1px dashed var(--t-frame);
    border-radius: 0;
  }

  .playground-output .output-pre {
    border: none;
  }

  .output-pre :global(.output-error) {
    color: var(--t-hot);
  }

  .playground :global(.output-dim) {
    color: var(--text-secondary);
  }

  /* The status line closes the session, like a board's bottom bar. */
  .playground-status {
    padding: 6px 16px;
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    color: var(--text-secondary);
    background: var(--surface-0);
    border-top: 1px dashed var(--t-frame);
    flex-shrink: 0;
  }

  .playground-status::before {
    content: "> " / "";
    color: var(--t-frame);
  }

  .playground-status.status-ready {
    color: var(--moss-t);
  }

  .playground-status.status-error {
    color: var(--t-hot);
  }

  .playground-status.status-running {
    color: var(--t-num);
  }

  @media (max-width: 768px) {
    .tour {
      grid-template-columns: 1fr;
    }

    .tour-steps {
      border-right: none;
      border-bottom: 1px dashed var(--t-frame);
    }

    .tour-panels {
      grid-template-columns: 1fr;
    }

    .playground-panes {
      flex-direction: column;
      height: auto;
    }

    .playground-editor {
      width: 100%;
      border-right: none;
      border-bottom: 1px dashed var(--t-frame);
      height: 320px;
    }

    .playground-output {
      width: 100%;
      min-height: 280px;
    }
  }
</style>

<script>
import { SCENARIOS, TOUR_STEPS, type ScenarioKey } from "../playground/scenarios";
import type { PlaygroundRuntime } from "../playground/runtime";
import type { EditorView } from "@codemirror/view";

type Runtime = typeof import("../playground/runtime");
type TenantRow = { id: string; parent_id: string | null; name: string };

const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

const statusEl = $("status");
const startBtn = $<HTMLButtonElement>("start-btn");

function setStatus(message: string, type = "") {
  statusEl.textContent = message;
  // classList keeps the class that Astro adds to scope the component styles.
  statusEl.classList.remove("status-ready", "status-error", "status-running");
  if (type) statusEl.classList.add("status-" + type);
}

function formatArg(arg: unknown): string {
  if (arg instanceof Error) return `${arg.name}: ${arg.message}`;
  return typeof arg === "object" ? JSON.stringify(arg, null, 2) : String(arg);
}

/**
 * Run a script with the given names in scope and return what it logged.
 *
 * The script is an async function body. console.log inside it writes to the
 * returned lines, and to the browser console as well.
 */
async function runScript(code: string, scope: Record<string, unknown>): Promise<{ lines: string[]; error?: unknown }> {
  const lines: string[] = [];
  const log = (...args: unknown[]) => lines.push(args.map(formatArg).join(" "));
  const sandboxConsole = { ...console, log, info: log, error: (...args: unknown[]) => log("[error]", ...args) };
  const names = [...Object.keys(scope), "console"];
  const fn = new Function(...names, `return (async () => {\n${code}\n})()`);
  const timeout = new Promise((_, reject) =>
    setTimeout(() => reject(new Error("The script ran for more than 15 seconds")), 15_000),
  );
  try {
    await Promise.race([fn(...Object.values(scope), sandboxConsole), timeout]);
    return { lines };
  } catch (error) {
    return { lines, error };
  }
}

let runtimeModule: Runtime;
let rt: PlaygroundRuntime;

function scope(extra: Record<string, unknown> = {}): Record<string, unknown> {
  return {
    stratum: rt.stratum,
    pool: rt.pool,
    appPool: rt.appPool,
    withTenantContext: runtimeModule.withTenantContext,
    enableRLS: runtimeModule.enableRLS,
    createPolicy: runtimeModule.createPolicy,
    ConfigLockedError: runtimeModule.ConfigLockedError,
    PermissionLockedError: runtimeModule.PermissionLockedError,
    StratumError: runtimeModule.StratumError,
    ...extra,
  };
}

// ---------------------------------------------------------------------------
// Guided tour
// ---------------------------------------------------------------------------

const tour = {
  current: 0,
  done: 0,
  tenants: {} as Record<string, { id: string; name: string }>,
  inspected: null as string | null,
};

const stepsEl = $<HTMLOListElement>("tour-steps");
const stepRunBtn = $<HTMLButtonElement>("step-run");
const tourOutput = $<HTMLPreElement>("tour-output");

function renderSteps() {
  stepsEl.textContent = "";
  TOUR_STEPS.forEach((step, index) => {
    const li = document.createElement("li");
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "step-btn";
    btn.dataset.step = step.id;
    btn.textContent = `${index + 1}. ${step.title}`;
    btn.classList.toggle("current", index === tour.current);
    btn.classList.toggle("done", index < tour.done);
    btn.addEventListener("click", () => {
      tour.current = index;
      renderSteps();
    });
    li.appendChild(btn);
    stepsEl.appendChild(li);
  });
  const step = TOUR_STEPS[tour.current];
  $("step-title").textContent = step.title;
  $("step-text").textContent = step.text;
  $("step-code").textContent = step.code ?? "";
  $("step-code").hidden = !step.code;
  stepRunBtn.disabled = !step.code || tour.current < tour.done;
  stepRunBtn.textContent = tour.current < tour.done ? "Done" : tour.current > tour.done ? "Run the steps up to here" : "Run this step";
}

function appendTourLines(lines: string[], isError = false) {
  for (const line of lines) {
    const span = document.createElement("span");
    if (isError) span.className = "output-error";
    span.textContent = line + "\n";
    tourOutput.appendChild(span);
  }
  tourOutput.scrollTop = tourOutput.scrollHeight;
}

async function renderTree() {
  const tree = $<HTMLUListElement>("tree");
  const { data } = await rt.stratum.listTenants({ limit: 100 });
  const rows = data as TenantRow[];
  tree.textContent = "";
  if (rows.length === 0) {
    tree.innerHTML = '<li class="output-dim">No tenants yet.</li>';
    return;
  }
  const build = (parentId: string | null, into: HTMLUListElement) => {
    for (const row of rows.filter((r) => r.parent_id === parentId)) {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "tree-node" + (row.id === tour.inspected ? " selected" : "");
      btn.textContent = row.name;
      btn.addEventListener("click", () => inspect(row.id));
      li.appendChild(btn);
      const children = document.createElement("ul");
      build(row.id, children);
      if (children.childElementCount > 0) li.appendChild(children);
      into.appendChild(li);
    }
  };
  build(null, tree);
}

function tenantName(id: string, names: Map<string, string>): string {
  return names.get(id) ?? id;
}

function cell(row: HTMLTableRowElement, text: string, badge?: string) {
  const td = document.createElement("td");
  if (badge) {
    const span = document.createElement("span");
    span.className = "badge " + badge;
    span.textContent = text;
    td.appendChild(span);
  } else {
    td.textContent = text;
  }
  row.appendChild(td);
}

function table(el: HTMLTableElement, caption: string, headers: string[]) {
  el.textContent = "";
  el.createCaption().textContent = caption;
  const head = el.createTHead().insertRow();
  for (const h of headers) {
    const th = document.createElement("th");
    th.textContent = h;
    head.appendChild(th);
  }
  return el.createTBody();
}

async function inspect(tenantId: string) {
  tour.inspected = tenantId;
  const { data } = await rt.stratum.listTenants({ limit: 100 });
  const names = new Map((data as TenantRow[]).map((t) => [t.id, t.name]));
  $("inspect-name").textContent = "for " + tenantName(tenantId, names);

  const config = await rt.stratum.resolveConfig(tenantId);
  const configBody = table($("inspector-config"), "Config", ["Key", "Value", "Set by", "State"]);
  for (const entry of Object.values(config)) {
    const row = configBody.insertRow();
    cell(row, entry.key);
    cell(row, JSON.stringify(entry.value));
    cell(row, tenantName(entry.source_tenant_id, names));
    cell(row, entry.locked ? "LOCKED" : entry.inherited ? "inherited" : "own", entry.locked ? "badge-locked" : undefined);
  }
  if (Object.keys(config).length === 0) cell(configBody.insertRow(), "No config yet.");

  const perms = await rt.stratum.resolvePermissions(tenantId);
  const permBody = table($("inspector-perms"), "Permissions", ["Key", "Mode", "Set by", "Delegated"]);
  for (const entry of Object.values(perms)) {
    const row = permBody.insertRow();
    cell(row, entry.key);
    cell(row, entry.mode, entry.mode === "LOCKED" ? "badge-locked" : entry.mode === "DELEGATED" ? "badge-delegated" : undefined);
    cell(row, tenantName(entry.source_tenant_id, names));
    cell(row, entry.delegated ? "yes" : "no");
  }
  if (Object.keys(perms).length === 0) cell(permBody.insertRow(), "No permissions yet.");
  await renderTree();
}

async function runTourStep(index: number): Promise<boolean> {
  const step = TOUR_STEPS[index];
  if (!step.code) return false;
  setStatus(`Running step ${index + 1}: ${step.title}`, "running");
  appendTourLines([`> ${index + 1}. ${step.title}`]);
  const { lines, error } = await runScript(step.code, scope({ t: tour.tenants }));
  appendTourLines(lines);
  if (error) {
    appendTourLines([formatArg(error)], true);
    setStatus(`Step ${index + 1} failed: ${formatArg(error)}`, "error");
    return false;
  }
  tour.done = index + 1;
  const focus = step.inspect ? tour.tenants[step.inspect] : undefined;
  if (focus) await inspect(focus.id);
  else await renderTree();
  return true;
}

stepRunBtn.addEventListener("click", async () => {
  stepRunBtn.disabled = true;
  for (let index = tour.done; index <= tour.current; index++) {
    if (!(await runTourStep(index))) break;
  }
  if (tour.current < TOUR_STEPS.length - 1 && tour.done > tour.current) tour.current += 1;
  if (!statusEl.classList.contains("status-error")) setStatus("Step done. Select a tenant in the tree to inspect it.", "ready");
  renderSteps();
});

async function resetTour() {
  await rt.reset();
  tour.current = 0;
  tour.done = 0;
  tour.tenants = {};
  tour.inspected = null;
  tourOutput.textContent = "";
  $("inspect-name").textContent = "";
  $("inspector-config").textContent = "";
  $("inspector-perms").textContent = "";
  await renderTree();
  renderSteps();
}

$("tour-reset").addEventListener("click", async () => {
  setStatus("Resetting the database", "running");
  await resetTour();
  setStatus("Ready: the tour starts again with an empty database.", "ready");
});

// ---------------------------------------------------------------------------
// Code editor
// ---------------------------------------------------------------------------

let editorView: EditorView | null = null;
let currentScenario: ScenarioKey = "flat";
const outputEl = $<HTMLPreElement>("output");
const runBtn = $<HTMLButtonElement>("run-btn");

function setOutput(text: string, isError = false) {
  outputEl.textContent = "";
  const span = document.createElement("span");
  if (isError) span.className = "output-error";
  span.textContent = text;
  outputEl.appendChild(span);
}

function setEditorCode(code: string) {
  editorView?.dispatch({ changes: { from: 0, to: editorView.state.doc.length, insert: code } });
}

async function createEditor() {
  const [{ EditorView, keymap, lineNumbers, highlightActiveLine }, { EditorState }, { javascript }, { oneDark }, { defaultKeymap, history, historyKeymap }] =
    await Promise.all([
      import("@codemirror/view"),
      import("@codemirror/state"),
      import("@codemirror/lang-javascript"),
      import("@codemirror/theme-one-dark"),
      import("@codemirror/commands"),
    ]);
  const state = EditorState.create({
    doc: SCENARIOS[currentScenario].code,
    extensions: [
      lineNumbers(),
      highlightActiveLine(),
      history(),
      keymap.of([...defaultKeymap, ...historyKeymap]),
      javascript(),
      // Earlier extensions take precedence in CodeMirror, so the well theme
      // goes ahead of One Dark and keeps its background and type.
      EditorView.theme({
        "&": { height: "100%", backgroundColor: "var(--well)" },
        ".cm-scroller": {
          fontFamily: "var(--bbs-font)",
          fontSize: "1.15rem",
          lineHeight: "1.35",
        },
        ".cm-content": { padding: "12px 0" },
        ".cm-gutters": {
          backgroundColor: "var(--well)",
          borderRight: "1px dashed #4A3B2F",
          color: "#C2B19A",
        },
        ".cm-activeLineGutter": { backgroundColor: "#33281F" },
        ".cm-activeLine": { backgroundColor: "rgba(255,255,255,0.03)" },
      }),
      oneDark,
      EditorView.lineWrapping,
    ],
  });
  editorView = new EditorView({ state, parent: $("editor") });
}

async function resetDatabase(message: string) {
  setStatus("Resetting the database", "running");
  await rt.reset();
  // The tour and the editor share one database, so a reset restarts the tour.
  await resetTour();
  setStatus(message, "ready");
}

document.querySelectorAll<HTMLButtonElement>(".scenario-tab").forEach((tab) => {
  tab.addEventListener("click", async () => {
    const key = tab.dataset.tab as ScenarioKey;
    document.querySelectorAll(".scenario-tab").forEach((t) => {
      t.classList.toggle("active", t === tab);
      t.setAttribute("aria-selected", String(t === tab));
    });
    currentScenario = key;
    setEditorCode(SCENARIOS[key].code);
    setOutput("");
    await resetDatabase("Ready: " + SCENARIOS[key].description);
  });
});

$("reset-btn").addEventListener("click", async () => {
  setEditorCode(SCENARIOS[currentScenario].code);
  setOutput("");
  await resetDatabase("Ready: the database is empty.");
});

runBtn.addEventListener("click", async () => {
  const code = editorView?.state.doc.toString() ?? "";
  if (!code.trim()) return;
  runBtn.disabled = true;
  setOutput("");
  setStatus("Running", "running");
  const { lines, error } = await runScript(code, scope());
  if (error) {
    setOutput((lines.length ? lines.join("\n") + "\n\n" : "") + formatArg(error), true);
    setStatus("Error: " + formatArg(error), "error");
  } else {
    setOutput(lines.join("\n") || "(no output)");
    setStatus("Done", "ready");
  }
  runBtn.disabled = false;
});

// ---------------------------------------------------------------------------
// Mode tabs and Start
// ---------------------------------------------------------------------------

document.querySelectorAll<HTMLButtonElement>(".mode-tab").forEach((tab) => {
  tab.addEventListener("click", async () => {
    document.querySelectorAll(".mode-tab").forEach((t) => {
      t.classList.toggle("active", t === tab);
      t.setAttribute("aria-selected", String(t === tab));
    });
    const editorMode = tab.dataset.mode === "editor";
    $("tour").hidden = editorMode;
    $("editor-mode").hidden = !editorMode;
    if (editorMode && !editorView) await createEditor();
  });
});

startBtn.addEventListener("click", async () => {
  startBtn.disabled = true;
  setStatus("Downloading PostgreSQL and Stratum", "running");
  try {
    runtimeModule = await import("../playground/runtime");
    rt = await runtimeModule.startPlayground((message) => setStatus(message, "running"));
  } catch (error) {
    console.error(error);
    setStatus("PostgreSQL did not start: " + formatArg(error), "error");
    startBtn.disabled = false;
    return;
  }
  $("pg-start").hidden = true;
  $("pg-app").hidden = false;
  renderSteps();
  setStatus(`Ready: PostgreSQL runs in your browser, with ${rt.migrations} Stratum migrations applied.`, "ready");
});
</script>
