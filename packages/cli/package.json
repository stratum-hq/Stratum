{
  "name": "@stratum-hq/cli",
  "version": "0.8.0",
  "description": "Multi-tenancy CLI for Node.js: add tenant isolation to an existing app, migrate tables to RLS, and check readiness",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenant",
    "tenant-isolation",
    "row-level-security",
    "rls",
    "postgresql",
    "cli",
    "scaffolding",
    "migration",
    "node",
    "typescript",
    "stratum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "stratum": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@stratum-hq/core": "^1.5.0",
    "@stratum-hq/lib": "^1.6.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://docs.stratum-hq.org/packages/cli/",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/cli"
  }
}
