{
  "name": "@stratum-hq/core",
  "version": "1.2.1",
  "description": "Stratum shared types, utilities, and validation schemas",
  "keywords": [
    "multi-tenancy",
    "multi-tenant",
    "saas",
    "tenant",
    "typescript",
    "validation",
    "schemas",
    "stratum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://github.com/stratum-hq/Stratum/tree/main/packages/core#readme",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/core"
  }
}
