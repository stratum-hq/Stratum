{
  "name": "@stratum-hq/db-adapters",
  "version": "1.5.0",
  "description": "Multi-tenant PostgreSQL row-level security for pg, Prisma, Drizzle, and Sequelize, plus schema-per-tenant and database-per-tenant isolation",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenant",
    "tenant-isolation",
    "row-level-security",
    "rls",
    "postgresql",
    "prisma",
    "drizzle",
    "drizzle-orm",
    "sequelize",
    "pg",
    "node-postgres",
    "schema-per-tenant",
    "database-per-tenant",
    "postgres",
    "schema-isolation",
    "database",
    "stratum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pglite": {
      "types": "./dist/pglite/index.d.ts",
      "default": "./dist/pglite/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types.json",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@stratum-hq/core": "^1.6.0",
    "pg": "^8.11.0",
    "pg-connection-string": "^2.6.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "drizzle-orm": ">=0.29.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@prisma/client": "^5.10.0",
    "@types/pg": "^8.11.0",
    "drizzle-orm": "^0.45.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://docs.stratum-hq.org/packages/db-adapters/",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/db-adapters"
  }
}
