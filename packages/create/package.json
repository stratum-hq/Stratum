{
  "name": "@stratum-hq/create",
  "version": "0.7.0",
  "description": "Scaffold a multi-tenant SaaS starter for Node.js: PostgreSQL, MySQL, or MongoDB with Express, Fastify, Next.js, Hono, or NestJS",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenant",
    "tenant-isolation",
    "row-level-security",
    "rls",
    "postgresql",
    "mysql",
    "mongodb",
    "express",
    "fastify",
    "nextjs",
    "hono",
    "nestjs",
    "prisma",
    "drizzle",
    "create",
    "scaffolding",
    "starter",
    "boilerplate",
    "node",
    "typescript",
    "stratum"
  ],
  "bin": {
    "create-stratum": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./matrix": "./dist/matrix.js"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@stratum-hq/* && esbuild src/matrix.ts --bundle --platform=node --format=esm --outfile=dist/matrix.js --external:@stratum-hq/* && esbuild src/bin.ts --platform=node --format=esm --outfile=dist/bin.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://docs.stratum-hq.org/packages/create/",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/create"
  }
}
