{
  "name": "@stratum-hq/lib",
  "version": "1.2.1",
  "description": "Stratum tenant management library - framework-agnostic business logic",
  "keywords": [
    "multi-tenancy",
    "multi-tenant",
    "saas",
    "b2b",
    "tenant",
    "tenant-management",
    "tenant-isolation",
    "node",
    "typescript",
    "postgresql",
    "row-level-security",
    "rls",
    "schema-isolation",
    "config-inheritance",
    "gdpr",
    "stratum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && cp -r src/migrations dist/migrations",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@stratum-hq/core": "*",
    "@stratum-hq/db-adapters": "*",
    "@stratum-hq/sdk": "*",
    "pg": "^8.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://github.com/stratum-hq/Stratum/tree/main/packages/lib#readme",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/lib"
  }
}
