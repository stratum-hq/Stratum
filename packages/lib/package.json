{
  "name": "@stratum-hq/lib",
  "version": "1.9.0",
  "description": "Multi-tenancy for Node.js and PostgreSQL: tenant hierarchy, config inheritance, row-level security, ABAC, audit log, and GDPR tooling",
  "keywords": [
    "multi-tenancy",
    "multitenancy",
    "multi-tenant",
    "saas",
    "tenant",
    "tenant-isolation",
    "row-level-security",
    "rls",
    "postgresql",
    "tenant-hierarchy",
    "ltree",
    "abac",
    "audit-log",
    "encryption",
    "webhooks",
    "b2b",
    "tenant-management",
    "node",
    "typescript",
    "schema-isolation",
    "config-inheritance",
    "gdpr",
    "stratum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/copy-dir.mjs src/migrations dist/migrations",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types.json",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@stratum-hq/core": "^1.6.0",
    "@stratum-hq/db-adapters": "^1.6.0",
    "@stratum-hq/sdk": "^1.4.0",
    "pg": "^8.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Christian Crank",
  "homepage": "https://docs.stratum-hq.org/packages/lib/",
  "bugs": "https://github.com/stratum-hq/Stratum/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratum-hq/Stratum.git",
    "directory": "packages/lib"
  }
}
