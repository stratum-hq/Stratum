---
// A full-width band of earth, drawn in half-block pixels. Depth picks the
// rocks it cuts through, shallow (0, with grass) to deep (3, bedrock with a
// magma vein). Decorative; scripts/ansi-fit.ts re-renders it for the width.
import { earthBand, rowsToHtml } from '../lib/ansi';

interface Props { depth: 0 | 1 | 2 | 3 }
const { depth } = Astro.props;
---
<pre class="art earth" data-earth={depth} data-cols="150" aria-hidden="true" set:html={rowsToHtml(earthBand(150, depth))} />

<script>
  import '../scripts/ansi-fit';
</script>
