<!-- Shared navigation component -->
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/favicon.svg" alt="Stratum" class="nav-logo-img" width="28" height="28" />
      Stratum
    </a>
    <div class="nav-end">
      <button class="nav-menu-btn" id="nav-menu-btn" type="button" aria-expanded="false" aria-controls="nav-menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        Menu
      </button>
      <div class="nav-links" id="nav-menu">
        <a href="/what-is-stratum/">What is Stratum?</a>
        <a href="/compare/">Compare</a>
        <a href="/blog/">Blog</a>
        <a href="https://docs.stratum-hq.org/">Docs</a>
        <a href="https://docs.stratum-hq.org/playground/">Playground</a>
        <a href="https://github.com/stratum-hq/Stratum">GitHub</a>
        <a href="/about/">About Us</a>
        <a href="/contact/">Contact</a>
      </div>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  const sunIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`;
  const moonIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;

  // The active theme is already resolved and applied pre paint in Base.astro
  // (Bedrock unless the visitor chose Daylight). Here we only mirror it on the
  // toggle icon and let the button flip and persist an explicit choice.
  const syncIcon = () => {
    const isLight = html.getAttribute('data-theme') === 'light';
    if (toggle) toggle.innerHTML = isLight ? moonIcon : sunIcon;
  };
  syncIcon();

  toggle?.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    try {
      localStorage.setItem('stratum-theme', next);
    } catch (e) {
      /* storage unavailable, theme still applies for this page */
    }
    syncIcon();
  });

  // Below 900px the links collapse behind the menu button (global.css, NAV).
  // The button is a disclosure: aria-expanded carries the state, Escape and a
  // click outside close the panel, and Escape returns focus to the button so
  // keyboard users do not lose their place.
  const nav = document.querySelector<HTMLElement>('.nav');
  const menuBtn = document.getElementById('nav-menu-btn');

  const setMenu = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  };

  menuBtn?.addEventListener('click', () => {
    setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menuBtn?.getAttribute('aria-expanded') !== 'true') return;
    setMenu(false);
    menuBtn.focus();
  });

  document.addEventListener('click', (event) => {
    if (nav && !nav.contains(event.target as Node)) setMenu(false);
  });

  // A panel left open on a phone must not stay open when the window grows
  // into the desktop layout, where the links show in the bar.
  matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>
