---
// A page title in the carved rock face. The art is aria-hidden; the heading
// carries the real text for assistive technology and search. Each entry in
// `lines` is drawn on its own row, so long titles can break where they read
// best. `weight="hero"` keeps the full chipped, two-pixel shadow look;
// `"heading"` opens the counters for smaller sizes.
import { logo, logoCols, rowsToHtml } from '../lib/ansi';

interface Props {
  lines: string[];
  label: string;
  as?: 'h1' | 'h2';
  weight?: 'hero' | 'heading';
  /** Largest cell size in px, so short titles do not grow without bound. */
  max?: number;
}
const { lines, label, as: Tag = 'h1', weight = 'hero', max = 16 } = Astro.props;
const opts = weight === 'hero' ? {} : { shadow: 1, chips: false };
const shadow = weight === 'hero' ? 2 : 1;
---
<Tag class={`rock-title rock-title-${weight}`}>
  <span class="sr-only">{label}</span>
  {lines.map((line) => (
    <span class="art rock-title-art" data-fit={logoCols(line, 2, shadow)} data-max={max} aria-hidden="true" set:html={rowsToHtml(logo(line, 0, 2, opts))} />
  ))}
</Tag>

<script>
  import '../scripts/ansi-fit';
</script>

<style>
  .rock-title { margin: 0; line-height: 1; }
  .rock-title-art { width: 100%; max-width: 100%; font-size: 8px; }
  .rock-title-art + .rock-title-art { margin-top: 0.4em; }
</style>
