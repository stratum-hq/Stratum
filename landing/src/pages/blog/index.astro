---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, postPath } from '../../lib/blog';

const posts = await getPosts();
import RockTitle from '../../../../assets/ansi/RockTitle.astro';
import EarthBand from '../../../../assets/ansi/EarthBand.astro';
---

<Base title="Blog · Stratum" description="Updates, guides, and insights about multi-tenancy in Node.js from the Stratum team.">

<Nav />

<!-- Blog index -->
<main class="blog-index">
  <header class="blog-header">
    <RockTitle lines={['BLOG']} label="Blog" />
    <p class="blog-subtitle">Thoughts on multi-tenancy, Node.js, and building Stratum in the open.</p>
    <div class="blog-feeds">
      <a href="/rss.xml" class="blog-feed-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        RSS
      </a>
      <a href="/atom.xml" class="blog-feed-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>
        Atom
      </a>
    </div>
  </header>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={postPath(post)} class="post-card-link">
          <time class="post-date" datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-description">{post.data.description}</p>
          <span class="post-read-more">Read post</span>
        </a>
      </li>
    ))}
  </ul>
</main>


<EarthBand depth={3} />

<Footer />

<style>
  .blog-index {
    max-width: 700px;
    margin: 0 auto;
    padding: calc(var(--space-8) * 4) var(--space-6) var(--space-8);
    flex: 1;
  }

  .blog-header {
    margin-bottom: var(--space-8);
  }

  .blog-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .blog-feeds {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Feeds and posts read as a board's message base: bracketed keys, and
     one entry per post split by dashed rules. */
  .blog-feed-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    font-family: var(--bbs-font);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--t-frame);
    text-decoration: none;
  }

  .blog-feed-link::before { content: '[\00a0'; }
  .blog-feed-link::after { content: '\00a0]'; }
  .blog-feed-link svg { display: none; }

  .blog-feed-link:hover,
  .blog-feed-link:focus-visible {
    background: var(--t-frame);
    color: var(--surface-0);
    outline: none;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 3px double var(--t-frame);
  }

  .post-card {
    border-bottom: 1px dashed var(--t-frame);
  }

  .post-card-link {
    display: block;
    padding: var(--space-6) var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .post-card-link:hover,
  .post-card-link:focus-visible {
    background: color-mix(in srgb, var(--t-frame) 8%, transparent);
    outline: none;
  }

  .post-card-link:focus-visible {
    outline: 2px solid var(--t-frame);
    outline-offset: -2px;
  }

  .post-date {
    display: block;
    font-family: var(--bbs-font);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    color: var(--t-frame);
    margin-bottom: var(--space-2);
  }

  .post-title {
    font-size: 1.75rem;
    color: var(--t-str);
    margin-bottom: var(--space-3);
    line-height: 1.1;
  }

  .post-description {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .post-read-more {
    font-family: var(--bbs-font);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--t-frame);
  }

  .post-read-more::before { content: '[\00a0'; }
  .post-read-more::after { content: '\00a0]'; }

  .post-card-link:hover .post-read-more {
    background: var(--t-frame);
    color: var(--surface-0);
  }

  @media (max-width: 640px) {
    /* The top padding clears the fixed nav, which is 69px tall on phones. */
    .blog-index {
      padding: calc(var(--space-8) * 3) var(--space-4) var(--space-8);
    }
  }
</style>


</Base>
