---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Code } from 'astro:components';

const setupCode = `import { Pool } from "pg";
import { Stratum } from "@stratum-hq/lib";

const stratum = new Stratum({ pool: new Pool(), autoMigrate: true });
await stratum.initialize();

// Create a hierarchy
const root = await stratum.createTenant({ name: "AcmeSec", slug: "acmesec" });
const msp  = await stratum.createTenant({ name: "NorthStar", slug: "northstar", parent_id: root.id });

// Config resolves up the ancestry chain
await stratum.setConfig(root.id, "max_users", { value: 1000, locked: false });
const config = await stratum.resolveConfig(msp.id);`;

// Published, installable packages under @stratum-hq/*. The private demo and
// integration-tests packages are not on npm, and @stratum-hq/stratum is an empty
// name reservation with no source, so none of them belong in a "published to npm"
// table. See .claude/CLAUDE.md section 2.
const packages = [
  { name: '@stratum-hq/core', desc: 'Shared types, Zod schemas, error classes. Everything depends on it.', tag: 'foundation' },
  { name: '@stratum-hq/lib', desc: 'The core library: tenants, config, ABAC, permissions, audit, GDPR, webhooks, crypto.', tag: 'start here' },
  { name: '@stratum-hq/control-plane', desc: 'Fastify v5 REST API with auth, scopes, OpenTelemetry, and Redis rate limiting.' },
  { name: '@stratum-hq/sdk', desc: 'HTTP client for the control plane, LRU cache, Express and Fastify middleware.' },
  { name: '@stratum-hq/db-adapters', desc: 'PostgreSQL: raw pg, Prisma, Sequelize, Drizzle, plus RLS and schema isolation.' },
  { name: '@stratum-hq/mongodb', desc: 'MongoDB tenant isolation with a Mongoose plugin.' },
  { name: '@stratum-hq/mysql', desc: 'MySQL isolation with TypeORM, Knex, and Sequelize helpers.', tag: 'new' },
  { name: '@stratum-hq/nestjs', desc: 'NestJS guard, @Tenant() decorator, DI module.' },
  { name: '@stratum-hq/hono', desc: 'Hono middleware with AsyncLocalStorage context.' },
  { name: '@stratum-hq/test-utils', desc: 'Cross-tenant isolation test assertions.' },
  { name: '@stratum-hq/compliance', desc: 'Compliance kernel: coverage scoring, a finding state machine, control types. No runtime dependencies.' },
  { name: '@stratum-hq/react', desc: 'React admin components: tenant tree, config editor, permission editor.' },
  { name: '@stratum-hq/cli', desc: 'Project init, migrate, scaffold, doctor.' },
  { name: '@stratum-hq/create', desc: 'Project scaffolding: npx @stratum-hq/create my-app.' },
];
---

<Base title="Stratum: Multi-Tenancy for Node.js | Tenant Hierarchy, Config Inheritance, Isolation" description="Drop-in multi-tenancy for Node.js and TypeScript. Hierarchical tenants, config inheritance, three isolation strategies (RLS, schema, database), GDPR compliance. Open source, MIT licensed.">
  <Fragment slot="head">
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "@id": "https://stratum-hq.org/#software",
    "name": "Stratum",
    "description": "Drop-in multi-tenancy for Node.js and TypeScript. Hierarchical tenants, config inheritance, three isolation strategies, GDPR tooling, and ABAC policy engine.",
    "url": "https://stratum-hq.org/",
    "codeRepository": "https://github.com/stratum-hq/Stratum",
    "programmingLanguage": ["TypeScript", "JavaScript"],
    "runtimePlatform": "Node.js",
    "license": "https://opensource.org/licenses/MIT",
    "author": { "@id": "https://stratum-hq.org/#organization" },
    "publisher": { "@id": "https://stratum-hq.org/#organization" }
  }
  </script>
  </Fragment>

<Nav />

<!-- Depth rail: the persistent stratigraphic signature. A thin left axis marked
     with tenant depth (d0..d3); the vein cursor tracks scroll, and marks light up
     as the active depth resolves downward. Desktop only, decorative. -->
<div class="depth-rail" aria-hidden="true">
  <div class="depth-rail-track"><span class="depth-rail-cursor" id="rail-cursor"></span></div>
  <ol class="depth-rail-marks">
    <li class="dm active" data-mark="0"><span class="dm-dot"></span><span class="dm-label">d0</span></li>
    <li class="dm" data-mark="1"><span class="dm-dot"></span><span class="dm-label">d1</span></li>
    <li class="dm" data-mark="2"><span class="dm-dot"></span><span class="dm-label">d2</span></li>
    <li class="dm" data-mark="3"><span class="dm-dot"></span><span class="dm-label">d3</span></li>
  </ol>
</div>

<!-- Hero -->
<section class="idx-hero" data-depth="0">
  <div class="idx-hero-inner">
    <div class="idx-hero-content">
      <h1 class="idx-display">Multi-tenancy<br/>for Node.js</h1>
      <p class="idx-hero-sub">
        When customers need tenants <em>inside</em> tenants, resellers, agencies,
        enterprise org trees, a <code>tenant_id</code> column stops working.
        Stratum is the full tenant layer: hierarchy, config inheritance,
        isolation strategies, and compliance. Start flat, grow deep.
      </p>
      <div class="hero-actions">
        <a href="https://docs.stratum-hq.org/getting-started/quick-start/" class="btn-primary">Get Started</a>
        <a href="https://docs.stratum-hq.org/playground/" class="btn-vein">Try it in your browser</a>
        <a href="https://github.com/stratum-hq/Stratum" class="btn-secondary">View on GitHub</a>
      </div>
      <div class="install-box">
        <code id="install-cmd">npm install <span class="pkg">@stratum-hq/lib</span> pg</code>
        <button class="install-copy" id="copy-btn" type="button" aria-label="Copy install command">copy</button>
      </div>
    </div>

    <!-- Inheritance flow: each tenant is a rock band colored by its depth. Values
         resolve down the strata in vein unless a parent locks a key; the locked
         key is a magma tag that carries the word LOCKED. -->
    <!-- The panel below is drawn for sighted visitors and hidden from assistive
         technology, so this list carries the same facts as text. -->
    <div class="visually-hidden">
      <p>Example tenant hierarchy:</p>
      <ul>
        <li>d0: AcmeSec, the root tenant.</li>
        <li>d1: NorthStar MSP, a reseller under AcmeSec.</li>
        <li>d2: client-alpha, under NorthStar MSP.</li>
        <li>d3: team-eng, under client-alpha.</li>
      </ul>
      <p>max_users is 1000, inherited from d0. data_region is locked: children cannot override it.</p>
    </div>
    <div class="inherit-panel fade-in" aria-hidden="true">
      <div class="inherit-label">tenant hierarchy</div>
      <div class="inherit-tree">
        <div class="itrow d0"><span class="idepth">d0</span><span class="inode">AcmeSec</span><span class="imeta">root tenant</span></div>
        <div class="itrow d1"><span class="idepth">d1</span><span class="inode">NorthStar MSP</span><span class="imeta">reseller</span></div>
        <div class="itrow d2"><span class="idepth">d2</span><span class="inode">client-alpha</span></div>
        <div class="itrow d3"><span class="idepth">d3</span><span class="inode">team-eng</span></div>
      </div>
      <div class="inherit-config">
        <div class="icfg icfg-resolved">
          <span class="ikey">max_users: <span class="ival">1000</span></span>
          <span class="tag tag-inherited"><span class="tag-glyph">↓</span>inherited from <span class="depth-ref">d0</span></span>
        </div>
        <div class="icfg icfg-locked">
          <span class="ikey">data_region: <span class="itag">children cannot override</span></span>
          <span class="tag tag-locked"><span class="tag-glyph">■</span>locked</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features: one continuous stack of rock, shallow to deep. Each band takes
     the rock color of its depth, so the order of the
     features is the order of the strata and cannot be shuffled for layout. -->
<section class="features" data-depth="1">
  <div class="features-heading fade-in">
    <h2>Built for hierarchical tenant architectures</h2>
    <p>Every feature maps to a real problem in multi-tenant SaaS, not a marketing checklist.</p>
  </div>

  <ol class="strata fade-in">
    <li class="stratum-band band-d0">
      <div class="band-face">
        <div class="band-head"><span class="band-depth">d0</span><h3>Tenant hierarchy</h3></div>
        <div class="band-body">
          <p class="band-lead">Nest tenants as deep as your customers need: resellers, their clients, and the teams inside them. Concurrent writes cannot corrupt the tree.</p>
          <p>Each tenant stores its path from the root in a PostgreSQL <code>ltree</code> column, a materialized path. Ancestor and subtree queries read that path instead of running recursive joins. Advisory locks, held for one transaction, serialize create and move.</p>
        </div>
      </div>
    </li>
    <li class="stratum-band band-d1">
      <div class="band-face">
        <div class="band-head"><span class="band-depth">d1</span><h3>Config inheritance</h3></div>
        <div class="band-body">
          <p class="band-lead">Set a value once and every descendant gets it. A parent can lock a key so that no child can change it.</p>
          <p>Values flow root to leaf. Children inherit, override, or are blocked by a locked key. Batch updates are atomic: if one key is locked or invalid, nothing is written, and the result names that key.</p>
        </div>
      </div>
    </li>
    <li class="stratum-band band-d2">
      <div class="band-face">
        <div class="band-head"><span class="band-depth">d2</span><h3>Permission delegation</h3></div>
        <div class="band-body">
          <p class="band-lead">Decide at every node of the tree what the tenants below it can change.</p>
          <p>A LOCKED permission holds for every descendant. INHERITED and DELEGATED permissions flow down, and a descendant can override them. Revocation is cascade (remove it from the whole subtree), soft (remove it only where it was set), or permanent (it cannot be revoked).</p>
        </div>
      </div>
    </li>
    <li class="stratum-band band-d3">
      <div class="band-face">
        <div class="band-head"><span class="band-depth">d3</span><h3>Three isolation strategies</h3></div>
        <div class="band-body">
          <p class="band-lead">Give each tenant the isolation its compliance requirements call for, and mix strategies in one deployment.</p>
          <p>Shared tables with RLS (row-level security, where PostgreSQL filters every row by tenant) cost the least. Schema-per-tenant gives a tenant its own schema. Database-per-tenant gives it its own database, the strongest separation.</p>
          <div class="isolation-diagram" aria-label="Isolation strategy comparison">
            <div class="isolation-stack">
              <div class="isolation-row iso-rls">
                <div class="isolation-face">
                  <span><span class="isolation-label">Shared RLS</span><span class="isolation-note">row_security = on · lowest cost</span></span>
                  <span class="isolation-mark">shallow</span>
                </div>
              </div>
              <div class="isolation-row iso-schema is-active">
                <div class="isolation-face">
                  <span><span class="isolation-label">Schema</span><span class="isolation-note">search_path = tenant_slug</span></span>
                  <span class="isolation-mark">in use</span>
                </div>
              </div>
              <div class="isolation-row iso-db">
                <div class="isolation-face">
                  <span><span class="isolation-label">Database</span><span class="isolation-note">dedicated database · strongest</span></span>
                  <span class="isolation-mark">deepest</span>
                </div>
              </div>
            </div>
            <div class="iso-code">
              <span class="iso-fn">stratum.createTenant</span>(&#123; ..., isolation_strategy: <span class="iso-accent">"SCHEMA_PER_TENANT"</span> &#125;)<br/>
              <span class="iso-cm">// each tenant gets its strategy when you create it</span>
            </div>
          </div>
        </div>
      </div>
    </li>
    <li class="stratum-band band-d4">
      <div class="band-face">
        <div class="band-head"><span class="band-depth">d4</span><h3>Audit, GDPR and encryption</h3></div>
        <div class="band-body">
          <p class="band-lead">Know who changed what, and answer GDPR export and erasure requests without building the tooling yourself.</p>
          <p>Every mutation is logged with the actor's identity. Data export (Article 20) and hard purge (Article 17) are built in, with consent tracking and an audit trail. AES-256-GCM encrypts sensitive values at rest. Optional OpenTelemetry tracing, Redis-backed rate limiting, and webhook delivery with a dead-letter queue.</p>
        </div>
      </div>
    </li>
  </ol>
</section>

<!-- Code Example -->
<section class="code-section" data-depth="2">
  <div class="code-section-inner fade-in">
    <div class="code-section-text">
      <h2>Eight lines to a working hierarchy</h2>
      <p>
        Connect a Postgres pool, create tenants with parent references, and config
        resolves automatically up the tree. No migrations to hand-write, no join
        tables to manage.
      </p>
    </div>
    <div class="code-block">
      <div class="code-block-header">
        <span class="code-block-filename">setup.ts</span>
      </div>
      <Code code={setupCode} lang="ts" theme="css-variables" />
      <div class="code-output">
        <span class="co-arrow">→</span>
        <span class="co-text">config.max_users = &#123; value: <span class="co-val">1000</span>, inherited: true, source_tenant_id: <span class="co-src">root.id</span> &#125;</span>
        <span class="co-tag">resolved from d0</span>
      </div>
    </div>
  </div>
</section>

<!-- Packages -->
<section class="packages" data-depth="3">
  <div class="packages-inner">
    <div class="packages-heading fade-in">
      <h2>{packages.length} packages. Pick what you need.</h2>
      <p>All published to npm under <code class="pkg-scope">@stratum-hq/*</code></p>
    </div>
    <table class="packages-table" aria-label="Stratum packages">
      <tbody>
        {packages.map((p) => (
          <tr>
            <td class="pkg-name">{p.name}</td>
            <td class="pkg-desc">{p.desc}{p.tag && <span class="pkg-tag">{p.tag}</span>}</td>
            <td class="pkg-actions"><a href={`https://www.npmjs.com/package/${p.name}`} class="pkg-link" aria-label={`${p.name} on npm`}>npm →</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- Close: reassurance from facts a visitor can check.
     No adoption numbers or logos: the project has none to show. -->
<section class="cta">
  <div class="idx-close fade-in">
    <h2>Start building.</h2>
    <div class="idx-close-body">
      <ul class="idx-proof">
        <li><a href="https://github.com/stratum-hq/Stratum/blob/main/LICENSE">MIT licensed</a>, with every line of the source on GitHub.</li>
        <li><a href="https://github.com/stratum-hq/Stratum/actions/workflows/ci-integration.yml">Integration tests</a> run against real PostgreSQL, MongoDB and MySQL in CI.</li>
        <li>Try it in the <a href="https://docs.stratum-hq.org/playground/">browser Playground</a> before you install anything.</li>
      </ul>
      <a href="https://docs.stratum-hq.org/getting-started/quick-start/" class="btn-primary">Get Started</a>
    </div>
  </div>
</section>

<Footer />

<style>
  /* Index hero. Plain ground with faint strata drifting behind it: two layers
     of thin rock lines that slide sideways at different speeds. No gradients. */
  .idx-hero {
    position: relative;
    background: var(--surface-0);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    isolation: isolate;
  }
  .idx-hero::before,
  .idx-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .idx-hero::before {
    background: repeating-linear-gradient(176deg, transparent 0 46px, var(--topsoil) 46px 50px, transparent 50px 121px, var(--clay) 121px 123px, transparent 123px 210px);
    background-size: 480px 100%;
    opacity: 0.2;
    animation: strata-drift-a 40s linear infinite;
  }
  .idx-hero::after {
    background: repeating-linear-gradient(183deg, transparent 0 77px, var(--sandstone-band) 77px 79px, transparent 79px 164px, var(--basalt) 164px 170px, transparent 170px 260px);
    background-size: 360px 100%;
    opacity: 0.18;
    animation: strata-drift-b 64s linear infinite;
  }
  @keyframes strata-drift-a { from { background-position: 0 0; } to { background-position: -480px 0; } }
  @keyframes strata-drift-b { from { background-position: 0 0; } to { background-position: 360px 0; } }
  @media (prefers-reduced-motion: reduce) {
    .idx-hero::before,
    .idx-hero::after { animation: none; }
  }
  .idx-hero-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 128px var(--space-6) var(--space-16);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }
  .idx-display {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7.5vw, 4.75rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 0.92;
    text-transform: uppercase;
    margin-bottom: var(--space-6);
    text-wrap: balance;
    color: var(--text-primary);
  }
  .idx-hero-sub {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
    max-width: 52ch;
  }
  .idx-hero-sub code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-primary);
    background: var(--surface-2);
    padding: 1px 6px;
  }

  /* Hidden from sight, still read by screen readers. Clipping the box, not
     display: none, keeps it in the accessibility tree. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Close. The heading takes the left column, the proof and the one magma
     action the right. The proof is plain prose with links, because each line
     points at something a visitor can check. */
  .idx-close {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8) var(--space-16);
    align-items: start;
  }
  .idx-close h2 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 0.92;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .idx-proof {
    list-style: none;
    margin-bottom: var(--space-8);
  }
  .idx-proof li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .idx-proof li:first-child { border-top: 1px solid var(--border); }
  .idx-proof a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }
  .idx-proof a:hover { text-decoration-color: var(--text-primary); }
  @media (max-width: 768px) {
    .idx-close { grid-template-columns: minmax(0, 1fr); }
  }

  /* One column on small screens. The tenant tree is the pitch, so it moves up
     to sit directly under the calls to action instead of below the install box,
     where it fell past the first phone screen. display: contents
     lifts the hero copy's children into this grid so they can be reordered. */
  @media (max-width: 900px) {
    .idx-hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: 96px;
    }
    .idx-hero-content { display: contents; }
    .inherit-panel { margin-bottom: var(--space-8); }
    .install-box { order: 1; }
  }
  @media (max-width: 480px) {
    .idx-hero-inner {
      padding-top: 80px;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .idx-display { font-size: 3rem; }
    .idx-hero-sub { font-size: 0.9375rem; }
    .hero-actions { flex-direction: column; gap: var(--space-2); }
    .hero-actions .btn-primary,
    .hero-actions .btn-vein,
    .hero-actions .btn-secondary { width: 100%; justify-content: center; }
    .install-box { max-width: 100%; }
  }
</style>

<script>
  // Copy the install command. The copied text is read from the DISPLAYED command
  // element, so what lands on the clipboard can never drift from what is shown.
  const copyBtn = document.getElementById('copy-btn');
  const cmdEl = document.getElementById('install-cmd');
  copyBtn?.addEventListener('click', async () => {
    const text = (cmdEl?.textContent ?? '').replace(/\s+/g, ' ').trim();
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = 'copied';
      copyBtn.classList.add('copied');
    } catch {
      copyBtn.textContent = 'copy failed';
    }
    setTimeout(() => {
      copyBtn.textContent = 'copy';
      copyBtn.classList.remove('copied');
    }, 2000);
  });

  // Depth rail: move the vein cursor with scroll progress and light up marks up
  // to the depth of the section currently in view.
  const rail = document.querySelector('.depth-rail');
  if (rail) {
    const cursor = document.getElementById('rail-cursor');
    const marks = Array.from(rail.querySelectorAll<HTMLElement>('.dm'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      if (cursor) cursor.style.top = `${progress * 100}%`;
      const mid = window.scrollY + window.innerHeight * 0.5;
      let active = 0;
      for (const s of sections) {
        if (s.offsetTop <= mid) active = Number(s.getAttribute('data-depth'));
      }
      for (const m of marks) {
        m.classList.toggle('active', Number(m.dataset.mark) <= active);
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Scroll animations.
  const fadeEls = document.querySelectorAll('.fade-in');
  if (fadeEls.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    fadeEls.forEach((el) => observer.observe(el));
  } else {
    fadeEls.forEach((el) => el.classList.add('visible'));
  }
</script>

</Base>
