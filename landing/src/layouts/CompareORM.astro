---
import Base from './Base.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RockTable from '../components/RockTable.astro';
import type { ORMComparison } from '../data/orm-comparisons';

interface Props {
  orm: ORMComparison;
}

const { orm } = Astro.props;
import RockTitle from '../components/RockTitle.astro';
import EarthBand from '../components/EarthBand.astro';
---

<Base
  title={`Stratum + ${orm.name}: Multi-Tenancy with ${orm.name} | Node.js`}
  description={`How Stratum works with ${orm.name}. Add hierarchical tenants, config inheritance, isolation strategies, and GDPR compliance to your ${orm.name} application.`}
>

<Nav />

<main class="orm-main">
  <header class="orm-header">
    <RockTitle lines={['STRATUM +', orm.name.toUpperCase()]} label={`Stratum + ${orm.name}`} />
    <p class="orm-tagline">{orm.tagline}</p>
  </header>

  <section class="orm-narrative">
    <p>{orm.description}</p>
    <p>Step-by-step setup: <a href={orm.docsGuide.href}>{orm.docsGuide.label}</a> in the Stratum docs.</p>
  </section>

  <section class="orm-features">
    <h2>Feature comparison</h2>
    <RockTable
      label={`Stratum with ${orm.name} feature comparison`}
      columns={['Capability', orm.name, 'Stratum']}
      rows={orm.features.map((f) => ({
        feat: f.capability,
        cells: [
          [f.verdict === 'good' || f.verdict === 'neutral' ? 'plain' : 'bad', f.orm] as const,
          ['good', f.stratum] as const,
        ],
      }))}
    />
  </section>

  <section class="orm-code">
    <h2>Getting started</h2>
    <div class="code-block">
      <div class="code-block-header">
        <span class="code-block-filename">{orm.codeExample.filename}</span>
      </div>
      <pre set:html={orm.codeExample.code} />
    </div>
  </section>

  {orm.gotchas && orm.gotchas.length > 0 && (
    <section class="orm-gotchas">
      <h2>Things to know</h2>
      <ul>
        {orm.gotchas.map((g) => (
          <li>{g}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="orm-cta layer">
    <h2>Start building with {orm.name} + Stratum</h2>
    <div class="orm-install">
      <code>npm install <span class="no-break">@stratum-hq/lib</span> pg</code>
    </div>
    <div class="orm-cta-links">
      <a href="https://docs.stratum-hq.org/getting-started/quick-start/" class="btn-primary">Get Started</a>
      <a href="/compare/" class="btn-secondary">All comparisons</a>
    </div>
  </section>
</main>


<EarthBand depth={3} />

<Footer />

<style>
  .orm-main {
    max-width: 700px;
    margin: 0 auto;
    padding: calc(var(--space-8) * 3) var(--space-6) var(--space-16);
  }

  .orm-header {
    margin-bottom: var(--space-8);
  }

  .orm-header h1 {
    font-size: clamp(2.25rem, 5vw, 2.75rem);
    font-weight: 900;
    line-height: 0.95;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .orm-tagline {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Narrative */
  .orm-narrative {
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }

  .orm-narrative p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .orm-narrative p + p {
    margin-top: var(--space-4);
  }

  .orm-narrative a {
    color: var(--sandstone);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Features */
  .orm-features {
    margin-bottom: var(--space-8);
  }

  .orm-features h2 {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    line-height: 0.95;
  }

  /* Code */
  .orm-code {
    margin-bottom: var(--space-8);
  }

  .orm-code h2 {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    line-height: 0.95;
  }

  /* Gotchas */
  .orm-gotchas {
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }

  .orm-gotchas h2 {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    line-height: 0.95;
  }

  .orm-gotchas ul {
    list-style: none;
    padding: 0;
  }

  .orm-gotchas li {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    padding-left: var(--space-4);
    position: relative;
  }

  .orm-gotchas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--warning);
  }

  /* CTA */
  /* A ledge panel (.layer in global.css). The top padding clears the lip. */
  .orm-cta {
    padding: calc(var(--space-8) + 10px) var(--space-6) var(--space-8);
    text-align: center;
  }

  .orm-cta h2 {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
    line-height: 0.95;
  }

  .orm-install {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--code-text);
    margin-bottom: var(--space-6);
  }

  .orm-cta-links {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

</Base>
