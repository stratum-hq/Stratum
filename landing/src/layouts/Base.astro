---
interface Props {
  title: string;
  description: string;
  /** The Open Graph type. A blog post sets "article". */
  ogType?: string;
  /** An absolute URL or a site path. */
  ogImage?: string;
  /** An absolute URL. Defaults to this page on stratum-hq.org. */
  canonical?: string;
  /** Keeps the page out of search results. The 404 page sets it. */
  noindex?: boolean;
}
const { title, description, ogType = 'website', ogImage = '/og.png', canonical, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, 'https://stratum-hq.org').href;
const imageUrl = new URL(ogImage, 'https://stratum-hq.org').href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Theme, resolved before first paint so there is no post paint flash.
       Bedrock (dark) is the default for every visitor, whatever the OS
       preference; Daylight applies only when the visitor picks it with the
       toggle, which stores the choice in localStorage. The docs site does the
       same (website/src/components/ThemeProvider.astro). Kept as is:inline so
       it runs synchronously in <head>. -->
  <script is:inline>
    (() => {
      try {
        const theme = localStorage.getItem('stratum-theme') === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content="Stratum" />
  <meta property="og:image" content={imageUrl} />
  {ogImage === '/og.png' && (
    <>
      <!-- The size is known for the site image only. -->
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="author" content="Stratum HQ" />
  <link rel="alternate" type="application/rss+xml" title="Stratum Blog" href="/rss.xml" />
  <link rel="alternate" type="application/atom+xml" title="Stratum Blog (Atom)" href="/atom.xml" />
  {/* A page that is not indexed has no canonical URL. */}
  {!noindex && <link rel="canonical" href={canonical ?? pageUrl} />}
  <!-- The Organization node is on every page. Other nodes refer to it by its
       @id. The home page adds the SoftwareSourceCode node for the library. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://stratum-hq.org/#organization",
    "name": "Stratum HQ",
    "url": "https://stratum-hq.org/",
    "logo": "https://stratum-hq.org/icon-512.png",
    "sameAs": [
      "https://github.com/stratum-hq",
      "https://www.npmjs.com/org/stratum-hq",
      "https://docs.stratum-hq.org/"
    ]
  }
  </script>
  <slot name="head" />
  <script defer data-domain="stratum-hq.org" src="https://plausible.io/js/script.js"></script>
  <link rel="icon" href="/favicon.ico?v=bedrock" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bedrock" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=bedrock" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Stratum identity fonts (Big Shoulders Display / Instrument Sans /
       Martian Mono), loaded non-blocking so first paint is never held on a
       font stylesheet. assets/tokens.css does not @import fonts; any remote
       font @import is still stripped from the landing bundle at build (see
       astro.config.mjs). -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Martian+Mono:wght@400;500;600&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Martian+Mono:wght@400;500;600&display=swap"
    />
  </noscript>
</head>
<body>
  <slot />
</body>
</html>
