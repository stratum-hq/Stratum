#!/bin/sh
#
# Stratum pre-push gate. Three stages, cheapest first:
#
#   1. Forbidden action guards. Refuses tag pushes, direct pushes to main, and
#      rewrites of main. See .githooks/forbidden-actions.sh.
#   2. The secret scan. Runs scripts/check-secrets.mjs over every commit the
#      push sends, and blocks the push on a finding. See docs/secret-scanning.md.
#   3. The verification gate. Runs `npm run verify` (lint, typecheck, test,
#      build) and blocks the push if anything fails.
#
# Installed automatically by the root `prepare` script on `npm install`, which
# points core.hooksPath at this directory.
#
# Emergency bypass:
#
#   git push --no-verify
#
# Use it when a verification failure is unrelated to your change (a flaky
# environment, an already-broken base branch) and you need the branch pushed
# anyway. CI still runs, so a bypassed push does not skip verification, it only
# defers it.
#
# --no-verify is a blunt instrument: git skips this hook entirely, guards
# included. It is not a way around the guards. Each guard has its own named
# escape hatch that unlocks exactly one thing, and pushing a tag is additionally
# gated server side by scripts/release-guard.sh, which --no-verify cannot reach.

hooks_dir=$(dirname "$0")
remote_name=${1:-origin}

# git writes the pushed refs to stdin once, and two stages read them.
refs=$(cat)

printf '%s\n' "$refs" | "$hooks_dir/forbidden-actions.sh" pre-push || exit 1

is_zero() {
	case "$1" in
	*[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

# A new branch has no remote sha. Its commits are the ones since it left the
# remote's default branch.
default_ref=$(git symbolic-ref -q "refs/remotes/$remote_name/HEAD" 2>/dev/null) ||
	default_ref="refs/remotes/$remote_name/main"

printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
	# An empty line has no ref. An all-zero local sha is a deletion, which sends
	# no commits.
	[ -n "$local_sha" ] || continue
	is_zero "$local_sha" && continue

	if ! is_zero "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		range="$remote_sha..$local_sha"
	elif base=$(git merge-base "$local_sha" "$default_ref" 2>/dev/null); then
		range="$base..$local_sha"
	else
		# A scan of the whole history reports tokens that the remote already has,
		# so the hook stops and asks for the missing ref instead.
		cat >&2 <<EOF
pre-push: no merge base between $local_ref and $default_ref, push blocked.

The hook scans only the commits that a new branch adds to the default branch.
Fetch the default branch, then push again:

  git fetch $remote_name
  git remote set-head $remote_name --auto

If the remote has no default branch yet, run \`npm run lint:secrets\`, then
push with --no-verify.

EOF
		exit 1
	fi

	echo "pre-push: scanning $local_ref ($range) for secrets"
	if ! node "$hooks_dir/../scripts/check-secrets.mjs" --range "$range"; then
		cat >&2 <<'EOF'

pre-push: secret scan failed, push blocked.

Rotate a real credential first, then remove it from every commit in the push.
A commit that deletes the token is not enough: the earlier commit still ships it.

EOF
		exit 1
	fi
done || exit 1

# `verify` arrives with the verification gate. Skip cleanly if it is not
# defined yet so this hook works on any branch.
if node -e "process.exit(require('./package.json').scripts.verify ? 0 : 1)" 2>/dev/null; then
	echo "pre-push: running npm run verify"

	if npm run verify; then
		exit 0
	fi

	cat >&2 <<'EOF'

pre-push: verification failed, push blocked.

Fix the failures above and push again, or bypass the gate with:

  git push --no-verify

EOF

	exit 1
fi

exit 0
